# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง/โปรเจกต์ของคุณ

PORT=3000
NODE_ENV=development

# บังคับต้องมีเมื่อ NODE_ENV=production (ยาวอย่างน้อย 32 ตัวอักษร) ไม่งั้นเซิร์ฟเวอร์จะไม่ยอมสตาร์ต
# สร้างคีย์สุ่ม: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# โดเมนที่เรียก API ข้ามเว็บได้ คั่นด้วยจุลภาค เว้นว่าง = ทุกโดเมน (ใช้ได้เฉพาะตอนพัฒนา)
# ALLOWED_ORIGINS=https://forno.example.com,https://www.forno.example.com

# เลือกฐานข้อมูลที่จะใช้: postgres | sqlite | mysql | mongodb | supabase
DB_DRIVER=postgres

# ---------- 1) PostgreSQL (ค่าเริ่มต้น) ----------
DATABASE_URL=postgresql://postgres:password@localhost:5432/pizza_shop
PGSSL=false

# ---------- 2) Supabase ----------
# Project Settings > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# PGSSL=true
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ---------- 3) SQLite ----------
SQLITE_FILE=./pizza_shop.db

# ---------- 4) MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pizza_shop

# ---------- 5) MongoDB ----------
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_shop
