    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "better-sqlite3": "^11.3.0",
    "mongoose": "^8.6.0",
