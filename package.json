{
  "name": "pizza-shop-api",
  "version": "1.0.0",
  "description": "ระบบสั่งพิซซ่าออนไลน์ - Express + PostgreSQL/Supabase/SQLite/MySQL/MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
